---
// Art from the table: every picture from the "D&D Pictures" album and the pictures reviewed from the
// Messenger chats, newest first, grouped by month. Data comes from scripts/album_gallery.py
// (gallery.json) and scripts/chat_photos.py (gallery-chat.json).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import album from '../data/gallery.json';
import chat from '../data/gallery-chat.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (src: string) => base + src;
type Item = { src: string; thumb: string; width: number; height: number; date: string; caption: string; title?: string; description?: string };
const items = [...(album as Item[]), ...(chat as Item[])].sort((a, b) => b.date.localeCompare(a.date));
const monthName = (ym: string) => new Date(`${ym}-15T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const months: { key: string; label: string; items: Item[] }[] = [];
for (const item of items) {
	const key = item.date.slice(0, 7);
	let m = months.at(-1);
	if (!m || m.key !== key) months.push((m = { key, label: monthName(key), items: [] }));
	m.items.push(item);
}
let index = 0;
---

<StarlightPage frontmatter={{ title: 'Gallery', description: 'Art from the table: every picture from the campaigns, newest first.', tableOfContents: false, pagefind: false }}>
	<p>
		{items.length} pictures from the table, newest first. Select one to see it large; use the arrow keys to move through them.
	</p>
	<nav class="gal-months" aria-label="Months">
		{months.map((m) => <a href={`#m-${m.key}`}>{m.label} <span>{m.items.length}</span></a>)}
	</nav>

	{
		months.map((m) => (
			<section class="gal-month" id={`m-${m.key}`}>
				<h2>{m.label}</h2>
				<ul class="gal-grid">
					{m.items.map((item) => (
						<li>
							<a
								href={url(item.src)}
								class="gal-item"
								data-index={index++}
								data-src={url(item.src)}
								data-title={item.title ?? ''}
								data-caption={item.description ?? item.caption}
								data-date={item.date}
								title={item.title || item.caption || item.date}
							>
								<img src={url(item.thumb)} alt={item.title || item.caption || `Picture from ${item.date}`} loading="lazy" decoding="async" width="480" height={Math.round((480 * item.height) / item.width)} />
								{(item.title || item.caption) && <span class="gal-cap">{item.title || item.caption}</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}

	<dialog class="gal-box" aria-label="Picture">
		<button type="button" class="gal-close" aria-label="Close">×</button>
		<button type="button" class="gal-prev" aria-label="Previous picture">‹</button>
		<figure>
			<img alt="" />
			<figcaption><strong class="gal-box-title"></strong><span class="gal-box-desc"></span></figcaption>
		</figure>
		<button type="button" class="gal-next" aria-label="Next picture">›</button>
	</dialog>
</StarlightPage>

<script>
	const items = [...document.querySelectorAll<HTMLAnchorElement>('.gal-item')];
	const box = document.querySelector<HTMLDialogElement>('.gal-box');
	if (box && items.length) {
		const img = box.querySelector('img')!;
		const capTitle = box.querySelector<HTMLElement>('.gal-box-title')!;
		const capDesc = box.querySelector<HTMLElement>('.gal-box-desc')!;
		let current = 0;
		const show = (i: number) => {
			current = (i + items.length) % items.length;
			const a = items[current];
			img.src = a.dataset.src!;
			img.alt = a.dataset.title || a.dataset.caption || '';
			capTitle.textContent = a.dataset.title || '';
			capDesc.textContent = [a.dataset.caption, a.dataset.date].filter(Boolean).join(' · ');
		};
		items.forEach((a, i) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				show(i);
				box.showModal();
			}),
		);
		box.querySelector('.gal-close')!.addEventListener('click', () => box.close());
		box.querySelector('.gal-prev')!.addEventListener('click', () => show(current - 1));
		box.querySelector('.gal-next')!.addEventListener('click', () => show(current + 1));
		box.addEventListener('click', (e) => {
			if (e.target === box) box.close(); // click outside the picture
		});
		document.addEventListener('keydown', (e) => {
			if (!box.open) return;
			if (e.key === 'ArrowLeft') show(current - 1);
			if (e.key === 'ArrowRight') show(current + 1);
		});
	}
</script>

<style>
	.gal-months {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.9rem;
		font-size: var(--sl-text-sm);
		margin-bottom: 1rem;
	}
	.gal-months span {
		color: var(--sl-color-gray-4);
	}
	.gal-grid {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 0.6rem;
	}
	.gal-grid li {
		margin: 0;
	}
	.gal-item {
		display: block;
		position: relative;
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid var(--gold, #8a6d2f);
		background: var(--sl-color-gray-6);
		aspect-ratio: 1;
	}
	.gal-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 250ms ease;
	}
	.gal-item:hover img {
		transform: scale(1.04);
	}
	.gal-cap {
		position: absolute;
		inset: auto 0 0 0;
		padding: 0.3rem 0.45rem;
		font-size: var(--sl-text-xs);
		line-height: 1.25;
		color: #f3e7cf;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.gal-box {
		max-width: min(96vw, 110rem);
		max-height: 96vh;
		padding: 0.5rem 3rem;
		border: 1px solid var(--gold, #8a6d2f);
		background: #110e0a;
		color: #f3e7cf;
	}
	.gal-box::backdrop {
		background: rgba(0, 0, 0, 0.8);
	}
	.gal-box figure {
		margin: 0;
		text-align: center;
	}
	.gal-box img {
		max-width: 100%;
		max-height: 84vh;
		object-fit: contain;
	}
	.gal-box figcaption {
		font-size: var(--sl-text-sm);
		margin-top: 0.4rem;
		max-width: 60rem;
		margin-inline: auto;
	}
	.gal-box-title {
		display: block;
		font-family: 'Cinzel', var(--sl-font);
		font-size: var(--sl-text-base);
	}
	.gal-box button {
		position: absolute;
		background: none;
		border: 0;
		color: #f3e7cf;
		font-size: 2.4rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.2rem 0.6rem;
	}
	.gal-close {
		top: 0.2rem;
		right: 0.2rem;
	}
	.gal-prev {
		left: 0.2rem;
		top: 45%;
	}
	.gal-next {
		right: 0.2rem;
		top: 45%;
	}
</style>
