---
// A campaign's articles by group: the highlights first, then the rest behind a toggle.
import { href, blurb, type Doc } from '../lib/articles';
import type { CampaignGroup, GroupKey } from '../lib/campaigns';

interface Props {
	title: string;
	groups: CampaignGroup[];
}
const { title, groups } = Astro.props;

const ICONS: Record<GroupKey, string> = {
	people:
		'<circle cx="12" cy="7.5" r="3.5"/><path d="M5.5 20c0-3.9 2.9-6.5 6.5-6.5s6.5 2.6 6.5 6.5z"/><circle cx="4.8" cy="9.5" r="2.4"/><path d="M.8 18.5c0-2.8 1.7-4.8 4-4.8.8 0 1.5.2 2.1.6-1.7 1.3-2.7 3.4-2.9 4.2z"/><circle cx="19.2" cy="9.5" r="2.4"/><path d="M23.2 18.5c0-2.8-1.7-4.8-4-4.8-.8 0-1.5.2-2.1.6 1.7 1.3 2.7 3.4 2.9 4.2z"/>',
	places: '<path fill-rule="evenodd" d="M12 22s-7-6.6-7-12a7 7 0 0 1 14 0c0 5.4-7 12-7 12zm0-9.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6z"/>',
	organizations:
		'<rect x="9" y="2.5" width="6" height="5.5" rx=".6"/><rect x="1.5" y="15.5" width="6" height="5.5" rx=".6"/><rect x="9" y="15.5" width="6" height="5.5" rx=".6"/><rect x="16.5" y="15.5" width="6" height="5.5" rx=".6"/><path d="M11.2 8h1.6v3h7.5v4.5h-1.6v-2.9h-5.9v2.9h-1.6v-2.9H5.3v2.9H3.7V11h7.5z"/>',
	history: '<path d="M5 2h14v2h-1.5c0 4-3 5.6-4.3 8 1.3 2.4 4.3 4 4.3 8H19v2H5v-2h1.5c0-4 3-5.6 4.3-8C9.5 9.6 6.5 8 6.5 4H5z"/>',
	sessions: '<path fill-rule="evenodd" d="M5 2.5h14a1 1 0 0 1 1 1v17a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-17a1 1 0 0 1 1-1zm3 4.5v1.8h8V7zm0 4.1v1.8h8v-1.8zm0 4.1V17h5v-1.8z"/>',
	lore: '<path d="M11.2 5.6C9.2 4.3 6 3.8 2 4.3v14.2c4-.5 7.2 0 9.2 1.4zM12.8 5.6c2-1.3 5.2-1.8 9.2-1.3v14.2c-4-.5-7.2 0-9.2 1.4z"/>',
};

const entry = (e: Doc) => ({ url: href(e), title: e.data.title, sealed: !!e.data.redacted, blurb: blurb(e) });
---

<details class="cp-index not-content" open>
	<summary>
		<h2 id="campaign-index">{title} Campaign Index</h2>
	</summary>
	<div class="cp-index-body">
		{groups.length === 0 && <p>No articles are listed under this campaign yet.</p>}
		{
			groups.map((g) => (
				<section class="cp-group">
					<svg class="cp-group-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={ICONS[g.key]} />
					<div>
						<h3>{g.label}</h3>
						{g.featured.length > 0 && (
							<>
								{g.featuredLabel && <p class="cp-group-sub">{g.featuredLabel}</p>}
								<ul>
									{g.featured.map(entry).map((a) => (
										<li>
											<a href={a.url}>{a.title}</a>
											{a.sealed && <span class="cp-sealed"> (sealed)</span>}
											{a.blurb && <span class="cp-blurb"> — {a.blurb}</span>}
										</li>
									))}
								</ul>
							</>
						)}
						{g.rest.length > 0 && (
							<details class="cp-rest" open={g.featured.length === 0}>
								<summary>{g.featured.length > 0 ? `${g.rest.length} more` : `All ${g.rest.length}`}</summary>
								<ul>
									{g.rest.map(entry).map((a) => (
										<li>
											<a href={a.url}>{a.title}</a>
											{a.sealed && <span class="cp-sealed"> (sealed)</span>}
											{a.blurb && <span class="cp-blurb"> — {a.blurb}</span>}
										</li>
									))}
								</ul>
							</details>
						)}
					</div>
				</section>
			))
		}
	</div>
</details>

<style>
	.cp-index {
		border: 1px solid var(--gold, #8a6d2f);
		border-radius: 6px;
		margin-top: 1.5rem;
	}
	.cp-index > summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 1.4rem;
		cursor: pointer;
		list-style: none;
	}
	.cp-index > summary::-webkit-details-marker {
		display: none;
	}
	.cp-index > summary::after {
		content: '';
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--sl-color-text-accent);
		border-bottom: 2px solid var(--sl-color-text-accent);
		transform: rotate(45deg);
		transition: transform 150ms ease;
		flex: none;
	}
	.cp-index[open] > summary::after {
		transform: rotate(-135deg);
	}
	.cp-index[open] > summary {
		border-bottom: 1px solid var(--gold, #8a6d2f);
	}
	.cp-index > summary h2 {
		margin: 0;
		border: 0;
		padding: 0;
		font-family: 'Cinzel', var(--sl-font);
		font-size: var(--sl-text-h3);
		font-variant: small-caps;
		color: var(--sl-color-text-accent);
	}
	.cp-group h3 {
		font-family: 'Cinzel', var(--sl-font);
	}
	.cp-group a {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.cp-group ul {
		list-style: disc;
	}
	.cp-group li::marker {
		color: var(--sl-color-text-accent);
	}
	.cp-index-body {
		padding: 0.4rem 1.4rem 1.2rem;
	}
	.cp-group {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0 1.2rem;
		margin-top: 1.1rem;
	}
	.cp-group-icon {
		width: 1.8rem;
		height: 1.8rem;
		color: var(--sl-color-text-accent);
		margin-top: 0.1rem;
	}
	.cp-group h3 {
		margin: 0;
		font-size: var(--sl-text-h5);
		font-variant: small-caps;
		letter-spacing: 0.04em;
		color: var(--sl-color-text-accent);
		border-bottom: 1px solid var(--gold, #8a6d2f);
		padding-bottom: 0.1rem;
	}
	.cp-group-sub {
		margin: 0.5rem 0 0;
		font-family: 'Spectral SC', var(--sl-font);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.cp-group ul {
		margin: 0.4rem 0 0;
		padding-left: 1.3rem;
	}
	.cp-group li {
		margin: 0.15rem 0;
	}
	.cp-group li a {
		font-weight: 600;
	}
	.cp-blurb {
		color: var(--sl-color-white);
	}
	.cp-sealed {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}
	.cp-rest {
		margin-top: 0.5rem;
	}
	.cp-rest > summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
</style>
