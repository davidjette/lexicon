---
// Right-rail box for an article: its lead image and its short template fields.
import { infoboxRows } from '../lib/fields';
import { mentionsSealed } from '../lib/articles';

interface Props {
	id: string;
	title: string;
	image?: { src: string; alt?: string; caption?: string };
	fields?: Record<string, string>;
}
const { id, title, image, fields } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = infoboxRows(fields, (text) => mentionsSealed(text, id));
const src = image?.src?.startsWith('/') ? base + image.src : image?.src;
---

{
	(image || rows.length > 0) && (
		<aside class="infobox" aria-label={`About ${title}`}>
			<div class="infobox__title">{title}</div>
			{image && (
				<a href={src} class="infobox__imglink">
					<img class="infobox__img" src={src} alt={image.alt ?? title} loading="eager" decoding="async" />
				</a>
			)}
			{image?.caption && <div class="infobox__caption">{image.caption}</div>}
			{rows.length > 0 && (
				<dl>
					{rows.map(([k, v]) => (
						<>
							<dt>{k}</dt>
							<dd>{v}</dd>
						</>
					))}
				</dl>
			)}
		</aside>
	)
}
