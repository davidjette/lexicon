---
import { getArticles, sortArticles, href, blurb, type Kind } from '../lib/articles';

interface Props {
	kind: Kind;
}
const entries = sortArticles(await getArticles(Astro.props.kind));
---

<p>{entries.length} articles.</p>
<ul class="kind-index">
	{
		entries.map((e) => (
			<li>
				<a href={href(e)}>{e.data.title}</a>
				{e.data.redacted && <span class="kind-index__sealed"> (sealed)</span>}
				{blurb(e) && <span class="kind-index__blurb">{blurb(e)}</span>}
			</li>
		))
	}
</ul>

<style>
	.kind-index {
		list-style: none;
		padding: 0;
	}
	.kind-index li {
		margin-block: 0.6rem;
	}
	.kind-index a {
		font-weight: 600;
	}
	.kind-index__blurb {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.kind-index__sealed {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}
</style>
