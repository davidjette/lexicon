---
// The banner at the top of a campaign page: wide art with the title and tagline over it.
import { withBase } from '../lib/campaigns';

interface Props {
	title: string;
	tagline?: string;
	banner?: string;
	position?: string;
}
const { title, tagline, banner, position = 'center' } = Astro.props;
---

<div class="cp-hero">
	{banner && <img src={withBase(banner)} alt="" style={`object-position: ${position}`} />}
	<span class="cp-hero-text">
		<span class="cp-hero-title">{title}</span>
		<span class="cp-hero-rule" aria-hidden="true"><i></i></span>
		{tagline && <span class="cp-hero-tagline">{tagline}</span>}
	</span>
</div>

<style>
	.cp-hero {
		display: block;
		position: relative;
		height: clamp(10rem, 20vw, 12.5rem);
		border: 1px solid var(--gold, #8a6d2f);
		border-radius: 6px;
		overflow: hidden;
		background: #1b1610;
	}
	.cp-hero img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.cp-hero-text {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 1rem clamp(1.2rem, 5vw, 4.5rem);
		background: linear-gradient(90deg, rgba(10, 8, 5, 0.88) 0%, rgba(10, 8, 5, 0.6) 40%, rgba(10, 8, 5, 0) 75%);
		color: #f3e7cf;
	}
	.cp-hero-title {
		font-family: 'Cinzel', var(--sl-font);
		font-weight: 500;
		font-size: clamp(1.7rem, 4.2vw, 2.9rem);
		line-height: 1.1;
		letter-spacing: 0.02em;
	}
	/* a fine gold rule with a diamond at its centre */
	.cp-hero-rule {
		width: min(17rem, 70%);
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.cp-hero-rule::before,
	.cp-hero-rule::after {
		content: '';
		flex: 1;
		height: 1px;
		background: #d9b56a;
	}
	.cp-hero-rule::after {
		background: linear-gradient(90deg, #d9b56a, rgba(217, 181, 106, 0));
	}
	.cp-hero-rule i {
		width: 0.42rem;
		height: 0.42rem;
		border: 1px solid #d9b56a;
		transform: rotate(45deg);
	}
	.cp-hero-tagline {
		font-size: var(--sl-text-lg);
		line-height: 1.35;
		max-width: 34rem;
	}
</style>
